# Configurazione Mako generata con Matugen

# --- Aspetto Generale ---
font=JetBrains Mono Nerd Font Propo 9
width=350
height=150
margin=16
padding=14
border-size=1
border-radius=12
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0

# --- Colori Base (Matugen) ---

# Text -> @on_surface
text-color=#e2e2e4

# Background -> @surface (con opacità ~85% -> D9)
# Nota: Mako accetta #RRGGBBAA
background-color=#121415D9

# Selected/Border -> @tertiary
border-color=#f2bc8e

# Progress Bar -> @tertiary (sovrapposto)
progress-color=over #f2bc8e

# --- Sezioni per Urgenza ---

[urgency=low]
border-color=#f2bc8e

[urgency=normal]
border-color=#f2bc8e

[urgency=high]
# Urgent -> @error
border-color=#ffb4ab
border-size=2
default-timeout=0

[urgency=critical]
# Urgent -> @error
border-color=#ffb4ab
border-size=2
default-timeout=0

# --- Categorie Specifiche (Opzionale) ---
# Simula lo stile del pulsante di chiusura se necessario,
# ma Mako non ha pulsanti fluttuanti come SwayNC.

[category=mpd]
border-color=#b9c9d2
default-timeout=2000
